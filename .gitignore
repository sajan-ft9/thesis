# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Data (never commit datasets or images)
data/raw/*
data/processed/*
data/synthetic/
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/splits/.gitkeep

# Trained models / weights (track via releases or DVC, not git)
models/*
!models/.gitkeep
*.pth
*.pt
*.onnx

# Results snapshot (figures/tables/metrics/gradcam) and the rendered thesis ARE
# committed as the thesis deliverable. Large model weights (*.pth/*.pt/*.onnx,
# above) and TensorBoard logs are NOT committed — regenerate them via `make reproduce`.
results/tensorboard/

# Local reference material (prompt + prior notebook/report) — not published
context/

# OS / editor
.DS_Store
.ipynb_checkpoints/
.idea/
.vscode/
