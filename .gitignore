# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Data (never commit datasets or images)
data/raw/*
data/processed/*
data/synthetic/
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/splits/.gitkeep

# Trained models / weights (track via releases or DVC, not git)
models/*
!models/.gitkeep
*.pth
*.pt
*.onnx

# Generated results (regenerated by `make reproduce`)
results/figures/*
results/tables/*
results/metrics/*
results/gradcam/*
results/confusion_matrices/*
results/roc_curves/*
results/tensorboard/
!results/**/.gitkeep

# Rendered thesis (regenerated)
reports/thesis_rendered.md

# Local reference material (prompt + prior notebook/report) — not published
context/

# OS / editor
.DS_Store
.ipynb_checkpoints/
.idea/
.vscode/
